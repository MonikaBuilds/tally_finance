# Tally Configuration
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_VERSION=prime
TALLY_UNAVAILABLE_COOLDOWN_SECONDS=30

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Optional model used only when Gemini returns a temporary 429/503.
GEMINI_FALLBACK_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Authentication & Security
CHAT_AUTH_ENABLED=true
CHAT_JWT_SECRET=your_jwt_secret_key_here
CHAT_JWT_ALGORITHM=HS256
CHAT_JWT_EXPIRE_MINUTES=60
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_PATH=/
AUTH_CSRF_COOKIE_NAME=csrf_token
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tally_financial_intelligence
DB_USER=tally_app
DB_PASSWORD=your_db_password

# Redis Caching Configuration
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_ENABLED=true
REDIS_CACHE_DEFAULT_FRESH_TTL=300
REDIS_CACHE_STALE_RETENTION_TTL=86400
REDIS_CACHE_KEY_PREFIX=tally:cache
REDIS_CACHE_REFRESH_ENABLED=true
REDIS_CACHE_REFRESH_INTERVAL_SECONDS=600
REDIS_CONNECT_TIMEOUT=2.0
REDIS_PROTOCOL=2
